---
// A chip showing a System Settings path, the last item highlighted (spec §7):
// System Settings ▸ Privacy & Security ▸ Paste from Other Apps.
interface Props {
  items: readonly string[];
}

const { items } = Astro.props;
---

<p
  class="mt-3 inline-flex flex-wrap items-center gap-1.5 rounded-[10px] border border-brand-border bg-brand-elevated px-3 py-2 text-[15px] font-medium"
>
  {
    items.map((item, i) => (
      <>
        {i > 0 && (
          <>
            <span aria-hidden="true">▸</span>
            <span class="sr-only">, </span>
          </>
        )}
        <span class:list={i === items.length - 1 ? 'font-semibold text-brand-accent' : 'text-brand-muted'}>{item}</span>
      </>
    ))
  }
</p>
