---
// A screenshot inside a shallow projected frame (spec §7): the window room's
// projection at 600∶411, lines and wall tints only, never a 3D tilt. The home
// safe-edits row uses it for the Discard alert.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  class?: string;
}

const { image, alt, class: className } = Astro.props;
---

<figure class:list={['relative m-0 aspect-[600/411]', className]}>
  <svg
    class="frame absolute inset-0 h-full w-full overflow-visible"
    viewBox="0 0 600 411"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <polygon class="wall-from" points="0,0 600,0 558,37 42,37" />
    <polygon class="wall-to" points="0,0 42,37 42,374 0,411" />
    <polygon class="wall-to" points="0,411 600,411 558,374 42,374" />
    <polygon class="wall-to" points="600,0 558,37 558,374 600,411" />
    <g class="wire" fill="none" stroke-width="1.1">
      <rect x=".5" y=".5" width="599" height="410" rx="22" vector-effect="non-scaling-stroke" />
      <line x1="6" y1="5" x2="42" y2="37" vector-effect="non-scaling-stroke" />
      <line x1="594" y1="5" x2="558" y2="37" vector-effect="non-scaling-stroke" />
      <line x1="6" y1="406" x2="42" y2="374" vector-effect="non-scaling-stroke" />
      <line x1="594" y1="406" x2="558" y2="374" vector-effect="non-scaling-stroke" />
    </g>
  </svg>
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 720, 960, 1280]}
    sizes="(min-width: 1024px) 540px, (min-width: 768px) 55vw, calc(100vw - 40px)"
    loading="lazy"
    class="absolute top-[9%] left-[7%] h-auto w-[86%] rounded-[1.8%/2.8%] shadow-[0_24px_48px_rgb(20_0_50/0.22),0_0_0_1px_rgb(0_0_0/0.06)] contrast-more:outline contrast-more:outline-brand-text"
  />
</figure>

<style>
  .frame {
    clip-path: inset(0 round 22px);
  }
  .wall-from {
    fill: var(--wall-from);
  }
  .wall-to {
    fill: var(--wall-to);
  }
  .wire {
    stroke: var(--wire);
  }
  @media (prefers-contrast: more) {
    .wire {
      stroke: var(--color-brand-text);
    }
  }
</style>
