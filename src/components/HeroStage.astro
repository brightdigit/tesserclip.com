---
// The dark hero stage (spec §5 exception, §7): a black rounded card with two
// purple glows, a faint 56 px grid masked to the glow, copy on the left and
// the static tesseract render on the right (one centred column below lg).
// It's dark in both colour schemes (`color-scheme: dark` on the card).
// TesseractHero (home) and the press key-art card use it.
//
// The art is one still image (spec §13, §14): decorative, eager, WebP/AVIF
// through astro:assets with explicit size. There is no animation.
import { Picture } from 'astro:assets';
import heroArt from '../assets/tesseract/tesseract-hero-1200.png';

interface Props {
  /** The heading id the section is labelled by. */
  labelledby: string;
  /** `home`: 460 px art. `press`: 380 px art, tighter padding. */
  variant?: 'home' | 'press';
}

const { labelledby, variant = 'home' } = Astro.props;
const press = variant === 'press';
---

<section aria-labelledby={labelledby} class="px-4 pt-4 md:px-6 md:pt-6">
  <div
    class:list={[
      'hero-card relative isolate mx-auto grid max-w-6xl gap-1 overflow-hidden rounded-[28px] border border-transparent px-[22px] pt-9 pb-5 text-center text-hero-ink lg:items-center lg:gap-6 lg:rounded-[32px] lg:pr-10 lg:text-left dark:border-white/6 contrast-more:border-white',
      press
        ? 'lg:grid-cols-[minmax(0,1fr)_380px] lg:py-10 lg:pl-[72px]'
        : 'lg:grid-cols-[minmax(0,1fr)_460px] lg:py-12 lg:pl-[72px]',
    ]}
  >
    <div class="hero-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div>
      <slot />
    </div>
    <div class="flex justify-center">
      <Picture
        src={heroArt}
        alt=""
        aria-hidden="true"
        formats={['avif', 'webp']}
        widths={press ? [480, 760] : [480, 920]}
        sizes={press ? '(min-width: 1024px) 380px, 240px' : '(min-width: 1024px) 460px, 240px'}
        width={press ? 380 : 460}
        height={press ? 380 : 460}
        loading="eager"
        class:list={['block h-[240px] w-[240px]', press ? 'lg:h-[380px] lg:w-[380px]' : 'lg:h-[460px] lg:w-[460px]']}
      />
    </div>
  </div>
</section>

<style>
  .hero-card {
    color-scheme: dark;
    background:
      radial-gradient(300px 260px at 50% 78%, var(--hero-glow-1), transparent 70%),
      radial-gradient(520px 420px at 50% 80%, var(--hero-glow-2), transparent 72%),
      var(--hero-bg);
  }
  .hero-grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(360px 300px at 50% 80%, #000, transparent 75%);
    mask-image: radial-gradient(360px 300px at 50% 80%, #000, transparent 75%);
  }
  @media (min-width: 64rem) {
    .hero-card {
      background:
        radial-gradient(300px 260px at 78% 50%, var(--hero-glow-1), transparent 70%),
        radial-gradient(560px 440px at 78% 52%, var(--hero-glow-2), transparent 72%),
        var(--hero-bg);
    }
    .hero-grid {
      -webkit-mask-image: radial-gradient(420px 340px at 78% 50%, #000, transparent 75%);
      mask-image: radial-gradient(420px 340px at 78% 50%, #000, transparent 75%);
    }
  }
</style>
