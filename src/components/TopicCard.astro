---
// An IconTile, a title and a line, linking to a page or an anchor (spec §7).
// Put the icon in the slot. The title is an h2 by default, so a row of cards
// right under the page’s h1 doesn’t skip a heading level.
import IconTile from './IconTile.astro';

interface Props {
  href: string;
  title: string;
  text: string;
  headingLevel?: 2 | 3;
}

const { href, title, text, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<a
  href={href}
  class="block rounded-2xl border border-brand-border bg-brand-surface p-6 text-inherit transition-colors hover:border-brand-accent"
>
  <IconTile class="mb-3.5"><slot /></IconTile>
  <Heading class="mb-1 text-[17px] text-brand-text">{title}</Heading>
  <p class="text-[15px] leading-normal text-brand-muted">{text}</p>
</a>
