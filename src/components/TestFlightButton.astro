---
// “Join the beta on / TestFlight” (spec §7). `filled` is the hero button,
// `outlined` (surface fill) is the footer variant.
import { TESTFLIGHT_URL } from '../config';
import NewTabNote from './NewTabNote.astro';
import TestFlightGlyph from './icons/TestFlightGlyph.astro';

interface Props {
  variant?: 'filled' | 'outlined';
  class?: string;
}

const { variant = 'filled', class: className } = Astro.props;
const filled = variant === 'filled';
---

<a
  href={TESTFLIGHT_URL}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'inline-flex items-center gap-3 rounded-2xl border py-3 pr-6 pl-[18px] text-left leading-[1.2] transition-colors',
    filled
      ? 'border-transparent bg-brand-accent-strong text-white shadow-[var(--shadow-accent)] hover:brightness-110'
      : 'border-brand-border bg-brand-surface text-brand-text hover:border-brand-accent',
    className,
  ]}
>
  <TestFlightGlyph class={filled ? 'text-white' : 'text-brand-accent'} />
  <span>
    <span class:list={['block text-xs', filled ? 'text-white/90' : 'text-brand-muted']}>Join the beta on</span>
    <span class="block text-[17px] font-semibold">TestFlight</span>
  </span>
  <NewTabNote />
</a>
