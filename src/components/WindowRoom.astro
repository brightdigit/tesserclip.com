---
// The window room (spec §7, §9.1 row 2): the flat editor screenshot as the
// back face of a projected cube. At md and up, four SVG wall polygons with
// hairline edges (1080∶740), the screenshot at 70 % width, wall labels that
// restate existing copy (real text, aria-hidden) and one glass callout chip,
// “Copy All ⇧⌘C”, the only Liquid Glass below the hero. Below md the walls,
// labels and chip hide and it falls back to the gradient stage, with the
// window cropped on the right and bottom.
//
// The screenshot carries the alt text and is the one fetchpriority="high"
// image (spec §14).
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Kbd from './Kbd.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
const label =
  'absolute hidden items-center gap-2 text-[13px] font-medium whitespace-nowrap text-room-label md:flex contrast-more:text-brand-text';
const sideLabel = 'top-1/2 w-[13%] justify-center text-center leading-[1.35] whitespace-normal';
---

<section aria-label="TesserClip window" class="pt-10 pb-16 md:pt-12 md:pb-24">
  <div class="mx-auto max-w-5xl px-5 md:px-6">
    <figure
      class="room relative m-0 h-[250px] overflow-hidden rounded-3xl bg-[linear-gradient(165deg,var(--stage-from),var(--stage-to))] px-5 pt-7 md:aspect-[1080/740] md:h-auto md:overflow-visible md:rounded-[28px] md:bg-none md:p-0"
    >
      <svg
        class="room-frame absolute inset-0 hidden h-full w-full overflow-visible md:block"
        viewBox="0 0 1080 740"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <polygon class="wall-from" points="0,0 1080,0 918,121 162,121" />
        <polygon class="wall-to" points="0,740 1080,740 918,616 162,616" />
        <polygon class="wall-to" points="0,0 162,121 162,616 0,740" />
        <polygon class="wall-to" points="1080,0 918,121 918,616 1080,740" />
        <g class="wire" fill="none" stroke-width="1.2">
          <rect x=".5" y=".5" width="1079" height="739" rx="28" vector-effect="non-scaling-stroke" />
          <line x1="8" y1="6" x2="162" y2="121" vector-effect="non-scaling-stroke" />
          <line x1="1072" y1="6" x2="918" y2="121" vector-effect="non-scaling-stroke" />
          <line x1="8" y1="734" x2="162" y2="616" vector-effect="non-scaling-stroke" />
          <line x1="1072" y1="734" x2="918" y2="616" vector-effect="non-scaling-stroke" />
        </g>
      </svg>
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[560, 720, 1120, 1440]}
        sizes="(min-width: 1024px) 684px, (min-width: 768px) 70vw, 560px"
        loading="eager"
        fetchpriority="high"
        class="block w-[560px] max-w-none rounded-[11px] shadow-[0_30px_60px_rgb(20_0_50/0.25),0_0_0_1px_rgb(0_0_0/0.06)] md:absolute md:top-[16.35%] md:left-[15%] md:w-[70%] md:rounded-[1.6%/2.5%] contrast-more:outline contrast-more:outline-brand-text"
      />
      <span
        class="chip absolute top-[calc(16.35%-46px)] left-[77.6%] hidden -translate-x-1/2 items-center gap-1.5 rounded-[10px] border border-[var(--glass-border)] bg-[var(--glass)] px-2.5 py-[5px] text-[13px] font-medium whitespace-nowrap text-brand-text shadow-[0_6px_20px_rgb(0_0_0/0.12)] backdrop-blur-[14px] backdrop-saturate-[1.7] md:inline-flex reduce-transparency:bg-brand-elevated reduce-transparency:backdrop-filter-none contrast-more:border-brand-text contrast-more:bg-brand-elevated contrast-more:backdrop-filter-none"
        aria-hidden="true"
      >
        Copy All <Kbd keys="⇧⌘C" class="text-[11px]" />
      </span>
      <span class:list={[label, 'top-[5.4%] left-1/2 -translate-x-1/2']} aria-hidden="true">
        New Window from Clipboard <Kbd keys="⌘N" class="text-[11px]" />
      </span>
      <span class:list={[label, sideLabel, 'right-[7.5%] translate-x-1/2 -translate-y-1/2']} aria-hidden="true">
        Edit ▸ Substitutions
      </span>
      <span class:list={[label, 'bottom-[5.4%] left-1/2 -translate-x-1/2']} aria-hidden="true">
        Undo <Kbd keys="⌘Z" class="text-[11px]" /> · Find <Kbd keys="⌘F" class="text-[11px]" />
      </span>
      <span class:list={[label, sideLabel, 'left-[7.5%] -translate-x-1/2 -translate-y-1/2']} aria-hidden="true">
        Plain text.<br />No files.
      </span>
    </figure>
  </div>
</section>

<style>
  .room-frame {
    clip-path: inset(0 round 28px);
  }
  .wall-from {
    fill: var(--wall-from);
  }
  .wall-to {
    fill: var(--wall-to);
  }
  .wire {
    stroke: var(--wire);
  }
  /* The chip's pointer: a rotated square in the chip's own colours. */
  .chip::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    transform: rotate(45deg);
    background: inherit;
    border-right: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  @media (prefers-contrast: more) {
    .wire {
      stroke: var(--color-brand-text);
    }
    .chip::after {
      border-color: var(--color-brand-text);
    }
  }
</style>
