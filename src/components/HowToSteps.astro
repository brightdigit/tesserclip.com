---
// Big numbered steps joined by a vertical rule, as an <ol> (spec §7). Each
// step is a <HowToStep title="…">.
---

<ol class="howto my-6 list-none p-0">
  <slot />
</ol>

<style>
  .howto {
    counter-reset: step;
  }
  .howto > :global(li) {
    counter-increment: step;
  }
  .howto > :global(li)::before {
    content: counter(step);
  }
</style>
