---
// The support page’s TopicCard (spec §7): IconTile, a title and a line. Named
// Support… so it doesn’t collide with #3’s TopicCard; the QA issue dedupes. Put the icon in the default slot. `action` adds the accent
// “Write to us ›” line; `external` opens the link in a new tab.
//
//   <SupportCard href="/help/" title="TesserClip Help" text="How windows…">
//     <SupportBookIcon />
//   </SupportCard>
import IconTile from './IconTile.astro';
import NewTabNote from './NewTabNote.astro';

interface Props {
  href: string;
  title: string;
  text: string;
  action?: string;
  external?: boolean;
  /** Heading level for the title, so the page outline stays in order. */
  level?: 2 | 3;
  class?: string;
}

const { href, title, text, action, external = false, level = 3, class: className } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<a
  href={href}
  class:list={[
    'block rounded-2xl border border-brand-border bg-brand-surface p-6 text-inherit transition-colors hover:border-brand-accent',
    className,
  ]}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <IconTile class="mb-[14px]"><slot /></IconTile>
  <Heading class="mb-1 text-[17px] leading-[1.3] font-semibold tracking-normal">{title}</Heading>
  <p class="text-[15px] leading-normal text-brand-muted">{text}</p>
  {
    action && (
      <span class="mt-3 inline-block text-[15px] font-medium text-brand-accent">
        {action}
        <svg class="ml-0.5 inline-block h-3 w-3 align-[-1px]" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M4.5 2.5 8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    )
  }
  {external && <NewTabNote />}
</a>
