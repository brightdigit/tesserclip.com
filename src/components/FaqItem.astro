---
// A <details> card with a +/− marker (spec §7). Works with the keyboard and
// without JS. The answer goes in the slot.
interface Props {
  question: string;
  open?: boolean;
}

const { question, open = false } = Astro.props;
---

<details class="group my-3 rounded-2xl border border-brand-border bg-brand-surface" open={open}>
  <summary
    class="flex cursor-pointer list-none justify-between gap-4 rounded-2xl px-5.5 py-4.5 text-[17px] font-medium text-brand-text [&::-webkit-details-marker]:hidden"
  >
    {question}
    <span class="text-[22px] leading-none font-light text-brand-muted" aria-hidden="true"
      ><span class="group-open:hidden">+</span><span class="hidden group-open:inline">−</span></span
    >
  </summary>
  <div class="px-5.5 pb-5 text-base leading-[1.6] text-brand-muted [&_p+p]:mt-2.5">
    <slot />
  </div>
</details>
