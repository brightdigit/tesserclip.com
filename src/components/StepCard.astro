---
// A numbered circle, title, one sentence and Kbd chips (spec §7).
import Kbd from './Kbd.astro';

interface Props {
  number: number;
  title: string;
  keys: string[];
}

const { number, title, keys } = Astro.props;
---

<li class="rounded-2xl border border-brand-border bg-brand-elevated p-6">
  <span
    class="mb-3.5 inline-flex h-8 w-8 items-center justify-center rounded-full bg-[color-mix(in_srgb,var(--color-brand-accent)_12%,transparent)] text-sm font-semibold text-brand-accent"
    aria-hidden="true">{number}</span
  >
  <h3 class="mb-1.5 text-lg"><span class="sr-only">Step {number}: </span>{title}</h3>
  <p class="text-[15px] leading-[1.55] text-brand-muted"><slot /></p>
  <div class="mt-4 flex flex-wrap gap-1.5">{keys.map((k) => <Kbd keys={k} />)}</div>
</li>
