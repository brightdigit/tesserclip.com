---
// The hero’s tint pill with a dot (spec §7). The copy comes from §8 through
// heroCopy(); pass nothing to render nothing.
interface Props {
  text?: string | null;
  class?: string;
}

const { text, class: className } = Astro.props;
---

{
  text && (
    <p
      class:list={[
        'inline-flex items-center gap-2 rounded-full border border-brand-tint-2 bg-brand-tint py-[5px] pr-3.5 pl-2.5 text-sm font-medium text-brand-accent',
        className,
      ]}
    >
      <span class="block h-2 w-2 rounded-full bg-brand-accent" aria-hidden="true" />
      {text}
    </p>
  )
}
