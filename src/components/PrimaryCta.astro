---
// The main call to action, switched by RELEASE_STATE (spec §8):
// beta → TestFlightButton, released → AppStoreBadge, comingSoon → nothing.
import { APP_STORE_ID, RELEASE_STATE } from '../config';
import AppStoreBadge from './AppStoreBadge.astro';
import TestFlightButton from './TestFlightButton.astro';

interface Props {
  /**
   * `hero`: the white-pill TestFlight button and the white badge (56 px) on
   * the dark hero card. `footer`: the outlined button and the scheme badge (48 px).
   */
  placement?: 'hero' | 'footer';
  class?: string;
}

const { placement = 'hero', class: className } = Astro.props;
const hero = placement === 'hero';
---

{RELEASE_STATE === 'beta' && <TestFlightButton variant={hero ? 'hero' : 'outlined'} class={className} />}
{
  RELEASE_STATE === 'released' && APP_STORE_ID && (
    <AppStoreBadge height={hero ? 56 : 48} artwork={hero ? 'white' : 'auto'} class={className} />
  )
}
