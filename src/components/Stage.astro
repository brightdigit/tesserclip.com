---
// The gradient stage behind a window cutout (spec §7).
//   variant="hero":  max-w-6xl panel, the window centred and cropped at the
//                    bottom, with an optional callout chip above the toolbar.
//   variant="split": a smaller panel, the window pinned top-left and cropped
//                    on the right and bottom.
// Screenshots go through astro:assets <Picture> (AVIF/WebP, responsive widths).
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Kbd from './Kbd.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  variant?: 'hero' | 'split';
  /** Hero only: a callout chip such as “Copy All ⇧⌘C”. */
  callout?: { label: string; keys: string };
  /** The hero image loads eagerly with fetchpriority="high"; everything else is lazy. */
  priority?: boolean;
  class?: string;
}

const { image, alt, variant = 'hero', callout, priority = false, class: className } = Astro.props;
const hero = variant === 'hero';
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : undefined;
---

{
  hero ? (
    <div
      class:list={[
        '-mx-5 h-[236px] overflow-hidden rounded-t-3xl bg-[linear-gradient(165deg,var(--stage-from),var(--stage-to))] md:mx-0 md:h-[500px] md:rounded-t-[32px]',
        className,
      ]}
    >
      <div class="relative mt-11 ml-5 w-[560px] md:mx-auto md:mt-[84px] md:w-[880px]">
        {callout && (
          <span class="callout absolute -top-[46px] left-[787px] hidden -translate-x-1/2 rounded-[9px] border border-brand-hairline bg-brand-elevated px-2.5 py-[5px] text-[13px] font-medium whitespace-nowrap text-brand-text md:block">
            {callout.label}
            <Kbd keys={callout.keys} class="ml-1 text-[11px]" />
          </span>
        )}
        <Picture
          src={image}
          alt={alt}
          formats={['avif', 'webp']}
          widths={[560, 880, 1120, 1616]}
          sizes="(min-width: 768px) 880px, 560px"
          loading={loading}
          fetchpriority={fetchpriority}
          class="block w-[560px] max-w-none rounded-[11px] shadow-[var(--shadow-window)] md:w-[880px] md:rounded-[17px]"
        />
      </div>
    </div>
  ) : (
    <div
      class:list={[
        'h-[260px] overflow-hidden rounded-3xl bg-[linear-gradient(165deg,var(--stage-from),var(--stage-to))] pt-6 pl-6 md:h-[420px] md:pt-10 md:pl-10',
        className,
      ]}
    >
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1440]}
        sizes="(min-width: 768px) 720px, 480px"
        loading={loading}
        fetchpriority={fetchpriority}
        class="block w-[480px] max-w-none rounded-tl-[14px] shadow-[var(--shadow-window)] md:w-[720px]"
      />
    </div>
  )
}

<style>
  /* The callout’s pointer: a rotated square in the chip’s own colours. */
  .callout {
    box-shadow: 0 6px 16px -6px rgb(46 14 84 / 0.35);
  }
  .callout::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 10px;
    height: 10px;
    background: inherit;
    border-right: 1px solid var(--color-brand-hairline);
    border-bottom: 1px solid var(--color-brand-hairline);
    transform: translateX(-50%) rotate(45deg);
  }
</style>
