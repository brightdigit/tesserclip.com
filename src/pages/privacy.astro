---
// /privacy (spec §9.4). Copy lives in src/content/legal/privacy.md.
import { getEntry } from 'astro:content';
import PrivacyCard from '../components/PrivacyCard.astro';
import PrivacySummary from '../components/PrivacySummary.astro';
import { SUPPORT_EMAIL } from '../config';
import ProseLayout from '../layouts/ProseLayout.astro';
import { fillTokens } from '../lib/legal';

const entry = await getEntry('legal', 'privacy');
if (!entry?.rendered) throw new Error('src/content/legal/privacy.md is missing');
const { title, description, lastUpdated, dateLabel } = entry.data;
const html = fillTokens(entry.rendered.html, { SUPPORT_EMAIL });
---

<ProseLayout
  title={`${title} – TesserClip`}
  description={description}
  heading={title}
  dateLabel={dateLabel}
  date={lastUpdated}
>
  <PrivacyCard slot="intro" compact><PrivacySummary /></PrivacyCard>
  <Fragment set:html={html} />
</ProseLayout>
