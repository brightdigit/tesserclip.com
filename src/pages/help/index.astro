---
// /help/ — Help ▸ TesserClip Help (⌘?) opens it in shipped app builds, so it
// must never move or 404 (spec §9.2, §10.1). Content: src/content/help/index.mdx.
import { getEntry, render } from 'astro:content';
import OnThisPage from '../../components/OnThisPage.astro';
import HelpLayout from '../../layouts/HelpLayout.astro';

const entry = await getEntry('help', 'index');
if (!entry) throw new Error('src/content/help/index.mdx is missing; /help/ is part of the app contract.');
const { Content } = await render(entry);

// The six stable anchors (spec §10). Keep them in sync with the MDX headings;
// `make check-links` fails on a missing fragment.
const anchors = [
  { href: '#getting-started', label: 'Getting started' },
  { href: '#windows', label: 'Windows and drafts' },
  { href: '#editor', label: 'The editor' },
  { href: '#shortcuts', label: 'Keyboard shortcuts' },
  { href: '#permission', label: 'Clipboard permission' },
  { href: '#faq', label: 'Questions' },
];
const links = [
  { href: '/help/clipboard-permission/', label: 'Clipboard permission article' },
  { href: '/support/', label: 'Contact support' },
];
---

<HelpLayout {...entry.data}>
  <OnThisPage slot="sidebar" anchors={anchors} links={links} />
  <Content />
</HelpLayout>
