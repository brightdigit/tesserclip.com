---
// /terms (spec §9.6). Copy lives in src/content/legal/terms.md.
import { getEntry } from 'astro:content';
import { SUPPORT_EMAIL } from '../config';
import ProseLayout from '../layouts/ProseLayout.astro';
import { fillTokens } from '../lib/legal';

const entry = await getEntry('legal', 'terms');
if (!entry?.rendered) throw new Error('src/content/legal/terms.md is missing');
const { title, description, lastUpdated, dateLabel } = entry.data;
const html = fillTokens(entry.rendered.html, { SUPPORT_EMAIL });
---

<ProseLayout
  title={`${title} – TesserClip`}
  description={description}
  heading={title}
  dateLabel={dateLabel}
  date={lastUpdated}
>
  <Fragment set:html={html} />
</ProseLayout>
