---
// 404 (spec §9.8, design 10-404). GitHub Pages serves dist/404.html at any
// depth, so every link and asset URL here stays root-absolute. noindex, and the
// sitemap filter in astro.config.mjs leaves it out.
import NotFoundClipboardIcon from '../components/icons/NotFoundClipboardIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page not found – TesserClip';
const description = 'We couldn’t find the page you’re looking for. It may have moved, or the link may be wrong.';
const button = 'inline-flex items-center gap-2 rounded-full px-[22px] py-[11px] text-[17px] leading-[1.6] font-medium transition hover:brightness-110';
---

<BaseLayout title={title} description={description} noindex>
  <section class="pt-[120px] pb-[140px] text-center">
    <div class="mx-auto max-w-2xl px-5 md:px-6">
      <NotFoundClipboardIcon class="mx-auto mb-6 h-[72px] w-[72px] text-brand-muted [stroke-width:1.2]" />
      <p class="mb-3 text-[15px] font-semibold tracking-[0.08em] text-brand-accent">404</p>
      <h1 class="text-[34px] leading-[1.08] font-bold tracking-[-0.028em] md:text-5xl">This page doesn’t contain text</h1>
      <p class="mx-auto mt-4 mb-9 max-w-[480px] text-lg leading-normal text-brand-muted md:text-[21px]">
        We couldn’t find the page you’re looking for. It may have moved, or the link may be wrong.
      </p>
      <div class="flex flex-col items-center justify-center gap-3.5 md:flex-row md:flex-wrap md:gap-5">
        <a class:list={[button, 'bg-brand-accent-strong text-white']} href="/">Go to the home page</a>
        <a class:list={[button, 'border border-brand-border text-brand-accent']} href="/help/">Browse Help</a>
      </div>
    </div>
  </section>
</BaseLayout>
