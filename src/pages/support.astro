---
// Stub from the scaffold (#1). Wave 1 replaces the body; keep the title and description (spec §9).
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Support – TesserClip';
const description = 'Get help with TesserClip: help articles, common questions, known issues and how to contact BrightDigit.';
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-2xl px-5 py-16 md:px-6 md:py-24">
    <h1 class="text-[34px] font-bold md:text-5xl">Support</h1>
    <p class="mt-4 text-lg text-brand-muted md:text-[21px] md:leading-normal">{description}</p>
  </section>
</BaseLayout>
