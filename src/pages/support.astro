---
// /support (spec §9.5, design 07-support). Also the App Store Connect Support URL.
// Changes from the design: no GitHub Issues card while REPO_PUBLIC is false
// (D12/D18), and the TestFlight feedback card links to testflight.apple.com.
import { RELEASE_STATE, REPO_PUBLIC, REPO_URL, SUPPORT_EMAIL } from '../config';
import SupportFaqItem from '../components/SupportFaqItem.astro';
import Kbd from '../components/Kbd.astro';
import IconTile from '../components/IconTile.astro';
import MenuPath from '../components/MenuPath.astro';
import Prose from '../components/Prose.astro';
import SupportCard from '../components/SupportCard.astro';
import SupportBookIcon from '../components/icons/SupportBookIcon.astro';
import SupportClipboardIcon from '../components/icons/SupportClipboardIcon.astro';
import SupportIssueIcon from '../components/icons/SupportIssueIcon.astro';
import SupportKeyboardIcon from '../components/icons/SupportKeyboardIcon.astro';
import SupportKnownIssuesIcon from '../components/icons/SupportKnownIssuesIcon.astro';
import SupportMailIcon from '../components/icons/SupportMailIcon.astro';
import SupportQuestionIcon from '../components/icons/SupportQuestionIcon.astro';
import TestFlightGlyph from '../components/icons/TestFlightGlyph.astro';
import { KNOWN_ISSUES } from '../data/known-issues';
import BaseLayout from '../layouts/BaseLayout.astro';
import { issuesUrl, knownIssuesHeading, supportVisibility } from '../lib/support';

const title = 'Support – TesserClip';
const description = 'Get help with TesserClip: help articles, common questions, known issues and how to contact BrightDigit.';

// Interim target until Leo picks one (spec §18, open question 4).
const TESTFLIGHT_FEEDBACK_URL = 'https://testflight.apple.com/';

const show = supportVisibility(RELEASE_STATE, REPO_PUBLIC);
const knownHeading = knownIssuesHeading(KNOWN_ISSUES);
const contactCount = 1 + (show.githubCard ? 1 : 0) + (show.testflightCard ? 1 : 0);
const sectionHeading = 'mt-[72px] mb-5 flex items-center gap-4';
const h2 = 'text-[30px] tracking-[-0.022em]';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-[760px] px-5 pb-24 md:px-6">
    <div class="pt-14 pb-2 md:pt-[72px]">
      <h1 class="text-[34px] leading-[1.08] font-bold tracking-[-0.028em] md:text-5xl">Support</h1>
      <p class="mt-[14px] text-lg leading-normal text-brand-muted md:text-[21px]">
        Find an answer in the help, or get in touch. We read every message.
      </p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      <SupportCard href="/help/" title="TesserClip Help" text="How windows, the editor and shortcuts work." level={2}><SupportBookIcon /></SupportCard>
      <SupportCard href="/help/clipboard-permission/" title="Clipboard permission" text="Let TesserClip show your copied text." level={2}
        ><SupportClipboardIcon /></SupportCard
      >
      <SupportCard href="/help/#shortcuts" title="Keyboard shortcuts" text="Every command and its keys." level={2}><SupportKeyboardIcon /></SupportCard>
    </div>

    <section aria-labelledby="common-title">
      <div class={sectionHeading} id="common">
        <IconTile><SupportQuestionIcon /></IconTile>
        <h2 id="common-title" class={h2}>Common questions</h2>
      </div>
      <SupportFaqItem question="Why is my new window empty?">
        <p>
          The clipboard may not contain text, or TesserClip may not have permission to read it. Paste with <Kbd keys="⌘V" />, or <a
            href="/help/clipboard-permission/">allow clipboard access</a
          >.
        </p>
      </SupportFaqItem>
      <SupportFaqItem question="What do I need to run TesserClip?">
        <p>A Mac with macOS 27 or later.</p>
      </SupportFaqItem>
      {
        show.joinBetaFaq && (
          <SupportFaqItem question="How do I join the beta?">
            <p>Install TestFlight from the Mac App Store, then open the TesserClip beta link on your Mac.</p>
          </SupportFaqItem>
        )
      }
      <SupportFaqItem question="Where are my drafts stored?">
        <p>On your Mac, inside TesserClip’s own container. They’re never uploaded. See the <a href="/privacy/">Privacy Policy</a>.</p>
      </SupportFaqItem>
    </section>

    {
      knownHeading && (
        <section aria-labelledby="known-title">
          <div class={sectionHeading} id="known">
            <IconTile>
              <SupportKnownIssuesIcon />
            </IconTile>
            <h2 id="known-title" class={h2}>
              {knownHeading}
            </h2>
          </div>
          <Prose>
            <ul>
              {KNOWN_ISSUES.items.filter((item) => item.trim() !== '').map((item) => <li>{item}</li>)}
            </ul>
          </Prose>
        </section>
      )
    }

    <section aria-labelledby="contact-title">
      <div class={sectionHeading} id="contact">
        <IconTile><SupportMailIcon /></IconTile>
        <h2 id="contact-title" class={h2}>Contact us</h2>
      </div>
      <div class:list={['grid gap-4', contactCount >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
        <SupportCard href={`mailto:${SUPPORT_EMAIL}`} title="Email" text={SUPPORT_EMAIL} action="Write to us"><SupportMailIcon /></SupportCard>
        {
          show.githubCard && (
            <SupportCard href={issuesUrl(REPO_URL)} title="GitHub Issues" text="Report a bug or request a feature." action="Open an issue" external>
              <SupportIssueIcon />
            </SupportCard>
          )
        }
        {
          show.testflightCard && (
            <SupportCard
              href={TESTFLIGHT_FEEDBACK_URL}
              title="TestFlight feedback"
              text="Testing the beta? Send feedback and screenshots from TestFlight."
              action="How to send"
              external
            >
              <TestFlightGlyph />
            </SupportCard>
          )
        }
      </div>
      <div class="mt-7 flex gap-[14px] rounded-[14px] border border-brand-border bg-brand-surface px-5 py-[18px] text-base leading-[1.55]">
        <SupportQuestionIcon class="mt-px h-[22px] w-[22px] shrink-0 text-brand-accent" />
        <p>
          <strong class="font-semibold">Help us help you.</strong> Include your macOS version, TesserClip’s version (choose <MenuPath
            items={['TesserClip', 'About TesserClip']}
          />), what you did, and what you expected to happen.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
