---
// Layout for the help pages (spec §7, §10): BaseLayout, Breadcrumbs, the h1
// and lead, then the article. With a "sidebar" slot (the help index) it lays
// out a 208 px sidebar beside a 720 px article; without one it is a single
// ~760 px column. Adds the BreadcrumbList JSON-LD (spec §12).
//
//   <HelpLayout title=… description=… heading=… lead=… breadcrumb=… related=…>
//     <OnThisPage slot="sidebar" … />   ← optional
//     <Content />
//   </HelpLayout>
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JsonLd from '../components/JsonLd.astro';
import ChevronIcon from '../components/icons/ChevronIcon.astro';
import { APP_NAME, SITE_URL } from '../config';
import type { NavLink } from '../data/navigation';
import { breadcrumbList, type Crumb } from '../lib/breadcrumbs';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  /** The h1. */
  heading: string;
  lead: string;
  /** This page’s crumb label (“Help”, “Clipboard permission”). */
  breadcrumb: string;
  related?: readonly NavLink[];
}

const { title, description, heading, lead, breadcrumb, related = [] } = Astro.props;

const HELP_PATH = '/help/';
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const crumbs: Crumb[] = [{ name: APP_NAME, path: '/' }];
if (path !== HELP_PATH) crumbs.push({ name: 'Help', path: HELP_PATH });
crumbs.push({ name: breadcrumb, path });

const hasSidebar = Astro.slots.has('sidebar');
---

<BaseLayout title={title} description={description}>
  <JsonLd slot="head" schema={breadcrumbList(crumbs, Astro.site?.href ?? SITE_URL)} />
  <div class:list={['mx-auto px-5 pb-24 md:px-6', hasSidebar ? 'max-w-[1120px]' : 'max-w-[760px]']}>
    <header class="pt-16 pb-2 md:pt-18">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="text-[34px] leading-[1.08] font-bold tracking-[-0.028em] md:text-5xl">{heading}</h1>
      <p class="mt-3.5 max-w-[640px] text-lg leading-normal text-brand-muted md:text-[21px]">{lead}</p>
    </header>
    {
      hasSidebar ? (
        <div class="mt-12 grid items-start gap-16 md:grid-cols-[208px_minmax(0,1fr)]">
          <slot name="sidebar" />
          <article class="help-prose text-links max-w-[720px] min-w-0">
            <slot />
          </article>
        </div>
      ) : (
        <article class="help-prose text-links">
          <slot />
        </article>
      )
    }
    {
      related.length > 0 && (
        <aside aria-labelledby="related" class="mt-14 border-t border-brand-hairline pt-7">
          <h2 id="related" class="mb-3 text-[13px] font-semibold tracking-[0.06em] text-brand-muted uppercase">
            Related
          </h2>
          <ul class="text-[17px] leading-[1.65]">
            {related.map((link) => (
              <li class="mb-4">
                <a href={link.href} class="text-brand-accent hover:underline">
                  {link.label}
                  <ChevronIcon />
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</BaseLayout>

<style is:global>
  /* Help article typography. It sits in the components layer with :where()
     selectors, so Tailwind utilities on the help components always win.
     Astro may inline this block before Tailwind's stylesheet, and the first
     @layer statement fixes the layer order, so restate Tailwind's order. */
  @layer theme, base, components, utilities;
  @layer components {
    .help-prose {
      --help-body: color-mix(in srgb, var(--color-brand-text) 82%, var(--color-brand-muted));
      font-size: 17px;
      line-height: 1.65;
    }
    @media (min-width: 48rem) {
      .help-prose {
        font-size: 18px;
      }
    }
    :where(.help-prose) > :where(h2) {
      font-size: 28px;
      margin: 56px 0 14px;
      letter-spacing: -0.02em;
    }
    :where(.help-prose) :where(h3) {
      color: var(--color-brand-text);
    }
    :where(.help-prose) > :where(h3) {
      font-size: 20px;
      margin: 32px 0 8px;
    }
    :where(.help-prose) > :where(p, ul, ol) {
      margin: 0 0 16px;
      color: var(--help-body);
    }
    :where(.help-prose) > :where(ul, ol) {
      padding-left: 22px;
    }
    :where(.help-prose) > :where(ul) {
      list-style: disc;
    }
    :where(.help-prose) > :where(ol) {
      list-style: decimal;
    }
    :where(.help-prose) > :where(ul, ol) > :where(li) {
      margin: 6px 0;
    }
    :where(.help-prose) :where(strong) {
      color: var(--color-brand-text);
      font-weight: 600;
    }
    /* Markdown tables (Windows and drafts): full width, and they scroll in
       their own wrapper rather than the page (spec §13). */
    :where(.help-prose) :where(.table-scroll) {
      max-width: 100%;
      overflow-x: auto;
      margin: 8px 0 24px;
    }
    :where(.help-prose) :where(.table-scroll table) {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 16px;
      border: 1px solid var(--color-brand-border);
      border-radius: 14px;
    }
    :where(.help-prose) :where(.table-scroll th, .table-scroll td) {
      padding: 12px 18px;
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--color-brand-hairline);
      color: var(--help-body);
    }
    :where(.help-prose) :where(.table-scroll tr:last-child td) {
      border-bottom: 0;
    }
    :where(.help-prose) :where(.table-scroll thead th) {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: var(--color-brand-muted);
      background: var(--color-brand-surface);
    }
    :where(.help-prose) :where(.table-scroll thead th:first-child) {
      border-top-left-radius: 13px;
    }
    :where(.help-prose) :where(.table-scroll thead th:last-child) {
      border-top-right-radius: 13px;
    }
  }
</style>
